#
# onyx_susfs.fragment - ReSukiSU + SUSFS, applied only when enable_susfs=true
#
# These symbols only exist once build-onyx.yml has applied the SUSFS patch
# (susfs4ksu, branch gki-android15-6.6). If the patch fails, olddefconfig drops
# every symbol here and the diffconfig gate fails the build -- which is the
# intended behaviour: a silently dead SUSFS is worse than a failed build.
#
# NOTE on CONFIG_KSU_SUSFS_SUS_PATH: it is a BOOL, not a string. An earlier
# revision of this file set it to "/system/susfs" on the assumption that it
# named the directory susfs mounts are hidden in; gate 2 rejected that:
#   onyx_gki_defconfig:870:warning: symbol value '"/system/susfs"' invalid for
#   KSU_SUSFS_SUS_PATH
# Kconfig's only valid string syntax in a defconfig is CONFIG_X="value", so
# that form being rejected means the symbol is not a string. gki-clo's
# original "=y" for all eight symbols was correct after all. If a future
# susfs4ksu revision does make this a string, gate 2 will say so again
# rather than the build silently mis-configuring.
#
CONFIG_KSU=y
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_HAS_MAGIC_MOUNT=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_AUTO_ADD_SUS_KSU_DEFAULT_KSU_DENYLIST=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_SUS_OVERLAYFS=y
CONFIG_KSU_SUSFS_SUS_PATH=y
